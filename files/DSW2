en
conf t
line console 0
logging synch
exec-timeout 0 0
exit

no ip domain-looku

hostname DSW2

vlan 10
name CLIENTS

vlan 20
name VOICE

vlan 30
name PRINTERS

vlan 40
name MANAGEMENT

interface range e0/2 - 3
switchport trunk encapsulation dot1q
switchport mode trunk
channel-group 1 mode passive
exit

spanning-tree mode rapid-pvst
spanning-tree vlan 1,10,20,30 priority 4096

spanning-tree vlan 10 hello-time 3
spanning-tree vlan 10 forward-time 10
spanning-tree vlan 10 max-age 20

interface Vlan 10
no shutdown
ip address 10.0.0.2 255.255.255.128

interface Vlan 20
no shutdown
ip address 10.0.0.130 255.255.255.192

interface Vlan 30
no shutdown
ip address 10.0.0.194 255.255.255.240

interface Vlan 40
no shutdown
ip address 10.0.0.210 255.255.255.248

